generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }

enum UserRole { ADMINISTRATOR ESTIMATOR LIFT_ENGINEER OPERATIONS_COORDINATOR WORKSHOP COMPLIANCE READ_ONLY }
enum JobStatus { ENQUIRY ASSESSMENT QUOTE_DRAFT CUSTOMER_APPROVAL LIFT_PLANNING READY_FOR_ALLOCATION COMPLETED }
enum ApprovalStatus { PENDING APPROVED REJECTED }
enum AttachmentType { DRAWING PHOTO EMAIL NOTE CALCULATION OTHER }

model User { id String @id @default(uuid()) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt email String @unique displayName String role UserRole active Boolean @default(true) jobsCreated Job[] @relation("JobCreator") auditLogs AuditLog[] approvals Approval[] attachments Attachment[] }
model Customer { id String @id @default(uuid()) name String createdAt DateTime @default(now()) updatedAt DateTime @updatedAt jobs Job[] }
model Site { id String @id @default(uuid()) customerId String name String address String customer Customer @relation(fields: [customerId], references: [id]) jobs Job[] }
model Contact { id String @id @default(uuid()) customerId String name String phone String email String customer Customer @relation(fields: [customerId], references: [id]) jobs Job[] }
model Job { id String @id @default(uuid()) jobNumber String @unique customerId String siteId String contactId String description String requestedDate DateTime status JobStatus @default(ENQUIRY) revision Int @default(1) deletedAt DateTime? createdById String createdAt DateTime @default(now()) modifiedById String modifiedAt DateTime @updatedAt customer Customer @relation(fields: [customerId], references: [id]) site Site @relation(fields: [siteId], references: [id]) contact Contact @relation(fields: [contactId], references: [id]) createdBy User @relation("JobCreator", fields: [createdById], references: [id]) quotes Quote[] liftPlans LiftPlan[] attachments Attachment[] workflowHistory WorkflowHistory[] statusHistory StatusHistory[] approvals Approval[] auditLogs AuditLog[] }
model Quote { id String @id @default(uuid()) jobId String revision Int @default(1) crane Decimal @db.Decimal(12,2) labour Decimal @db.Decimal(12,2) transport Decimal @db.Decimal(12,2) travel Decimal @db.Decimal(12,2) fuelLevy Decimal @db.Decimal(12,2) gst Decimal @db.Decimal(12,2) notes String? approvalStatus ApprovalStatus @default(PENDING) previousRevisionId String? createdAt DateTime @default(now()) job Job @relation(fields: [jobId], references: [id]) }
model LiftPlan { id String @id @default(uuid()) jobId String revision Int @default(1) weight Decimal @db.Decimal(12,2) dimensions String centreOfGravity String pickRadius Decimal @db.Decimal(8,2) setRadius Decimal @db.Decimal(8,2) craneModel String boomLength Decimal @db.Decimal(8,2) counterweight String outriggers String hookBlock String approvalStatus ApprovalStatus @default(PENDING) createdAt DateTime @default(now()) job Job @relation(fields: [jobId], references: [id]) rigging Rigging? }
model Rigging { id String @id @default(uuid()) liftPlanId String @unique hookWeight Decimal @db.Decimal(8,2) chains String shackles String spreaderBeam String totalRigging Decimal @db.Decimal(8,2) liftPlan LiftPlan @relation(fields: [liftPlanId], references: [id]) }
model Attachment { id String @id @default(uuid()) jobId String type AttachmentType filename String storagePath String version Int @default(1) uploadedById String uploadedAt DateTime @default(now()) immutable Boolean @default(true) job Job @relation(fields: [jobId], references: [id]) uploadedBy User @relation(fields: [uploadedById], references: [id]) }
model WorkflowHistory { id String @id @default(uuid()) jobId String fromStatus JobStatus toStatus JobStatus approvalComments String recordedById String recordedAt DateTime @default(now()) job Job @relation(fields: [jobId], references: [id]) }
model Approval { id String @id @default(uuid()) jobId String? quoteId String? status ApprovalStatus comments String reviewerId String reviewedAt DateTime @default(now()) job Job? @relation(fields: [jobId], references: [id]) reviewer User @relation(fields: [reviewerId], references: [id]) }
model AuditLog { id String @id @default(uuid()) jobId String? action String entityType String entityId String revision Int details Json createdById String createdAt DateTime @default(now()) job Job? @relation(fields: [jobId], references: [id]) createdBy User @relation(fields: [createdById], references: [id]) }
model StatusHistory { id String @id @default(uuid()) jobId String status JobStatus revision Int changedById String changedAt DateTime @default(now()) job Job @relation(fields: [jobId], references: [id]) }
